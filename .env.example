# Port exposed on the Proxmox host.
APP_PORT=8080

# API keys and source settings.
COLLECTOR__TICKETMASTERAPIKEY=
COLLECTOR__EVENTBRITETOKEN=

# Optional Eventbrite IDs. Add more by extending docker-compose.yml with
# Collector__EventbriteOrganizationIds__1, Collector__EventbriteVenueIds__1, etc.
COLLECTOR__EVENTBRITEORGANIZATIONIDS__0=
COLLECTOR__EVENTBRITEVENUEIDS__0=

COLLECTOR__ENABLEEVENSOS=true
COLLECTOR__ENABLETICKTS=false
